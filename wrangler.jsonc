{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farolimobiliario",
  "account_id": "749b2e9b3642e4b03321d5830e81c195",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "minify": true,
  "keep_vars": true,
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "vars": {
    "HARVEST_KEY": "farol-colheita-jp-2026"
  },
  "routes": [
    { "pattern": "farolqueprotege.com.br", "custom_domain": true },
    { "pattern": "www.farolqueprotege.com.br", "custom_domain": true }
  ]
}
